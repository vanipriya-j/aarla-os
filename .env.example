# -----------------------------------------------------------------------------
# Database — required for the app to load business data
# -----------------------------------------------------------------------------
# Local (Docker Postgres / Supabase Local on port 54322):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Cloud (for Vercel) — paste the URI from:
#   Supabase → Project Settings → Database → Connection string → URI
# SUPABASE_DB_URL is an optional alias; DATABASE_URL is preferred.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Force SSL on/off (auto-enabled for *.supabase.co and Vercel)
# DATABASE_SSL=true

# -----------------------------------------------------------------------------
# Supabase project (optional — not required for pg repositories)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
