# -----------------------------------------------------------------------------
# Database — required for the app to load business data
# -----------------------------------------------------------------------------
# Local (Docker Postgres / Supabase Local on port 54322):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Cloud (for Vercel) — Connect → Transaction pooler (port 6543) preferred:
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session pooler (:5432) is auto-rewritten to :6543 on Vercel unless:
# DATABASE_POOL_MODE=session

# Force SSL on/off (auto-enabled for *.supabase.co and Vercel)
# DATABASE_SSL=true

# Serverless pool size (default 1 on Vercel)
# DATABASE_POOL_MAX=1

# One-time browser bootstrap at /setup
# SETUP_SECRET=pick-a-long-random-phrase

# -----------------------------------------------------------------------------
# Role-based cookie auth (optional locally; set on Vercel for production)
# When any password is set, /login is required. Sessions live in auth_sessions.
# - admin: full Aarla OS (+ can revoke other sessions from Diagnostics)
# - crm: Customer Calls (+ commerce sync APIs) only
# -----------------------------------------------------------------------------
# AUTH_ADMIN_USERNAME=admin
# AUTH_ADMIN_PASSWORD=replace-with-strong-admin-password
# AUTH_CRM_USERNAME=crm
# AUTH_CRM_PASSWORD=replace-with-strong-crm-password
# AUTH_SESSION_TTL_DAYS=14

# -----------------------------------------------------------------------------
# Supabase project (optional — not required for pg repositories)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Shopify Admin API (server-only — never use NEXT_PUBLIC_ for these)
# Preferred (Dev Dashboard app): Client ID + Client secret.
# Scopes: read_customers, read_orders, preferably read_all_orders.
# Optional legacy: SHOPIFY_ADMIN_API_ACCESS_TOKEN (static shpat_… token).
# -----------------------------------------------------------------------------
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_CLIENT_ID=your_dev_dashboard_client_id
# SHOPIFY_CLIENT_SECRET=your_dev_dashboard_client_secret
# SHOPIFY_API_VERSION=2025-01
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_optional_legacy
# Pages of orders (~50 each) per serverless chunk (default 3)
# SHOPIFY_SYNC_MAX_PAGES=3

# Soft reserve API (Shopify → Aarla): machine auth for
# POST /api/integrations/shopify/reservations (not the Admin API token)
# SHOPIFY_INTEGRATION_SECRET=pick-a-long-random-phrase

# -----------------------------------------------------------------------------
# Delhivery tracking (server-only — never use NEXT_PUBLIC_ for these)
# Pull API: GET /api/v1/packages/json/?waybill=… (batch up to 30)
# Auth header: Authorization: Token <DELHIVERY_API_TOKEN>
# -----------------------------------------------------------------------------
# DELHIVERY_API_TOKEN=replace_me
# DELHIVERY_API_BASE_URL=https://track.delhivery.com
# DELHIVERY_USE_FIXTURE=1

