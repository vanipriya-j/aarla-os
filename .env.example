# -----------------------------------------------------------------------------
# Database — required for the app to load business data
# -----------------------------------------------------------------------------
# Local (Docker Postgres / Supabase Local on port 54322):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Cloud (for Vercel) — use Session pooler URI (not direct db.*.supabase.co):
#   Supabase → Project Settings → Database → Connection string → Session pooler → URI
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_DB_URL is an optional alias; DATABASE_URL is preferred.

# Force SSL on/off (auto-enabled for *.supabase.co and Vercel)
# DATABASE_SSL=true

# One-time browser bootstrap at /setup (required on Vercel if you have no local machine)
# SETUP_SECRET=pick-a-long-random-phrase

# -----------------------------------------------------------------------------
# Supabase project (optional — not required for pg repositories)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
