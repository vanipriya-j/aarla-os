# -----------------------------------------------------------------------------
# Database — required for the app to load business data
# -----------------------------------------------------------------------------
# Local (Docker Postgres / Supabase Local on port 54322):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Cloud (for Vercel) — Connect → Transaction pooler (port 6543) preferred:
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session pooler (:5432) is auto-rewritten to :6543 on Vercel unless:
# DATABASE_POOL_MODE=session

# Force SSL on/off (auto-enabled for *.supabase.co and Vercel)
# DATABASE_SSL=true

# Serverless pool size (default 1 on Vercel)
# DATABASE_POOL_MAX=1

# One-time browser bootstrap at /setup
# SETUP_SECRET=pick-a-long-random-phrase

# -----------------------------------------------------------------------------
# Supabase project (optional — not required for pg repositories)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
